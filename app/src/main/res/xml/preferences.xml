<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" >

    <androidx.preference.ListPreference
        android:defaultValue="system"
        android:dialogTitle="@string/pref_theme"
        android:entries="@array/pref_theme_entries"
        android:entryValues="@array/pref_theme_values"
        android:key="pref_theme"
        android:title="@string/pref_theme" />

    <androidx.preference.ListPreference
        android:defaultValue="blue"
        android:dialogTitle="@string/pref_palette"
        android:entries="@array/pref_palette_entries"
        android:entryValues="@array/pref_palette_values"
        android:key="pref_palette"
        android:title="@string/pref_palette" />

    <androidx.preference.ListPreference
        android:defaultValue="@string/pref_textSize_default"
        android:dialogTitle="@string/pref_textSize"
        android:entries="@array/pref_textSize_entries"
        android:entryValues="@array/pref_textSize_values"
        android:key="pref_textSize"
        android:title="@string/pref_textSize" />

</PreferenceScreen>

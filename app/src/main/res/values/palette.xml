<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The sand palette. It is applied on top of the theme chosen in the settings
        (light, dark or system), so the day and night colours come from the sand_* resources.
    -->
    <style name="PaletteOlive">
        <item name="colorPrimary">@color/olive_primary</item>
        <item name="colorOnPrimary">@color/olive_on_primary</item>
        <item name="colorPrimaryContainer">@color/olive_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/olive_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/olive_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/olive_on_secondary_container</item>
        <item name="colorSurface">@color/olive_surface</item>
        <item name="colorOnSurface">@color/olive_on_surface</item>
        <item name="colorSurfaceVariant">@color/olive_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/olive_on_surface_variant</item>
        <item name="colorOutline">@color/olive_outline</item>
        <item name="android:colorBackground">@color/olive_background</item>
    </style>

    <style name="PaletteSand">
        <item name="colorPrimary">@color/sand_primary</item>
        <item name="colorOnPrimary">@color/sand_on_primary</item>
        <item name="colorPrimaryContainer">@color/sand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sand_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/sand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/sand_on_secondary_container</item>
        <item name="colorSurface">@color/sand_surface</item>
        <item name="colorOnSurface">@color/sand_on_surface</item>
        <item name="colorSurfaceVariant">@color/sand_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/sand_on_surface_variant</item>
        <item name="colorOutline">@color/sand_outline</item>
        <item name="android:colorBackground">@color/sand_background</item>
    </style>

    <!-- The toolbar on the unlocked screen. Its icons and text take the container colour. -->
    <style name="HeaderToolbarTheme" parent="ThemeOverlay.Material3.ActionBar">
        <item name="colorControlNormal">?attr/colorOnPrimaryContainer</item>
        <item name="android:textColorPrimary">?attr/colorOnPrimaryContainer</item>
        <item name="android:textColorSecondary">?attr/colorOnPrimaryContainer</item>
    </style>

</resources>
